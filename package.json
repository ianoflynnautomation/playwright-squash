{
  "name": "@playwright-squash/playwright-squash",
  "version": "0.1.1",
  "description": "Sync Playwright tests into Squash TM and publish results into a campaign iteration.",
  "license": "ISC",
  "author": "Ian O Flynn",
  "type": "commonjs",
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ianoflynnautomation/playwright-squash.git"
  },
  "bugs": {
    "url": "https://github.com/ianoflynnautomation/playwright-squash/issues"
  },
  "homepage": "https://github.com/ianoflynnautomation/playwright-squash#readme",
  "keywords": [
    "playwright",
    "squash-tm",
    "test-management",
    "reporter"
  ],
  "files": [
    "dist",
    "squash-config.example.json"
  ],
  "exports": {
    "./annotations": {
      "types": "./dist/annotations.d.ts",
      "default": "./dist/annotations.js"
    },
    "./results": {
      "types": "./dist/reporters/results.reporter.d.ts",
      "default": "./dist/reporters/results.reporter.js"
    },
    "./sync": {
      "types": "./dist/reporters/sync.reporter.d.ts",
      "default": "./dist/reporters/sync.reporter.js"
    },
    "./select": {
      "types": "./dist/reporters/select.reporter.d.ts",
      "default": "./dist/reporters/select.reporter.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "playwright-squash": "./dist/cli/run.js",
    "playwright-squash-prune": "./dist/cli/prune.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "playwright test -c playwright.config.ts",
    "prepack": "tsc -p tsconfig.build.json",
    "smoke": "node scripts/smoke-install.mjs"
  },
  "peerDependencies": {
    "@playwright/test": "^1.64.1"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  }
}
